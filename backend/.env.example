# =============================================================================
# NeuroReach AI Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files to git — they contain secrets.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=false
APP_NAME=NeuroReach AI
APP_VERSION=1.0.0

# --- Database ---
DATABASE_URL=postgresql://neuroreach:your_password_here@localhost:5432/neuroreach

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_ENABLED=true

# --- Security (MUST change for production) ---
SECRET_KEY=generate-a-strong-random-key-here
ENCRYPTION_KEY=generate-a-64-char-hex-key-here

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (Paubox — HIPAA-compliant) ---
EMAIL_MODE=maildev
PAUBOX_API_KEY=
PAUBOX_API_USERNAME=
PAUBOX_API_BASE_URL=
PAUBOX_FROM_EMAIL=
PAUBOX_ENABLED=false

# --- SMS (Twilio) ---
SMS_MODE=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- CallRail ---
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=
CALLRAIL_COMPANY_ID=

# --- Google Ads ---
GOOGLE_ADS_WEBHOOK_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Email Branding ---
EMAIL_LOGO_URL=http://localhost:8000/static/images/logo.png
FROM_EMAIL=noreply@neuroreach.ai
REPLY_TO_EMAIL=ask@tmsinstitute.co
FROM_NAME=TMS Institute of Arizona
SUPPORT_PHONE=(480) 668-3599

# --- Elasticsearch (optional, disabled by default) ---
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED=300
