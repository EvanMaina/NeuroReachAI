                {"name": "ENCRYPTION_KEY", "value": "staging-a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456"},
                {"name": "DATABASE_URL", "value": "postgresql://neuroreach:NRstaging2026SecureP4ss@neuroreach-staging-db.cfggkciq6tun.us-east-2.rds.amazonaws.com:5432/neuroreach_staging"},
                {"name": "REDIS_URL", "value": "rediss://master.neuroreach-staging-redis.1kihud.use2.cache.amazonaws.com:6379/0?ssl_cert_reqs=CERT_NONE"},
